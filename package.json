{
  "name": "receipt-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon server/server.js",
    "dev:client": "vite --config client/vite.config.js --host 0.0.0.0 --port 5173",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/server.js",
    "test": "npm run test:server && npm run test:client",
    "test:server": "jest --runInBand",
    "test:client": "vitest --config client/vite.config.js run"
  },
  "dependencies": {
    "@google-cloud/vision": "^5.3.4",
    "@reduxjs/toolkit": "^2.9.0",
    "@tanstack/react-query": "^5.87.4",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.1",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "jest": "^30.1.3",
    "jsdom": "^26.1.0",
    "mongodb-memory-server": "^10.2.0",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.6",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.4.17",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/server/__tests__/**/*.test.js"
    ]
  }
}
